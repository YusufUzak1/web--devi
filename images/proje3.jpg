<svg xmlns="http://www.w3.org/2000/svg" width="400" height="225" viewBox="0 0 400 225">
  <defs>
    <linearGradient id="bg3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#16213e"/>
      <stop offset="100%" style="stop-color:#0f0f1a"/>
    </linearGradient>
  </defs>
  <rect width="400" height="225" fill="url(#bg3)" rx="8"/>
  <!-- Browser frame -->
  <rect x="20" y="15" width="360" height="195" fill="#1a1a2e" rx="6"/>
  <rect x="20" y="15" width="360" height="25" fill="#0f0f1a" rx="6"/>
  <circle cx="38" cy="28" r="4" fill="#ff6b6b"/>
  <circle cx="52" cy="28" r="4" fill="#ffd700"/>
  <circle cx="66" cy="28" r="4" fill="#00e676"/>
  <rect x="100" y="23" width="200" height="10" fill="#16213e" rx="5"/>
  <!-- Header -->
  <rect x="20" y="40" width="360" height="30" fill="#6c5ce7" opacity="0.3"/>
  <rect x="30" y="50" width="80" height="10" fill="#e4e4ed" rx="3" opacity="0.6"/>
  <rect x="280" y="50" width="30" height="8" fill="#9d9daf" rx="3" opacity="0.4"/>
  <rect x="320" y="50" width="30" height="8" fill="#9d9daf" rx="3" opacity="0.4"/>
  <!-- Content blocks -->
  <rect x="30" y="80" width="150" height="10" fill="#e4e4ed" rx="3" opacity="0.5"/>
  <rect x="30" y="96" width="340" height="6" fill="#9d9daf" rx="3" opacity="0.3"/>
  <rect x="30" y="108" width="300" height="6" fill="#9d9daf" rx="3" opacity="0.3"/>
  <!-- Project cards -->
  <rect x="30" y="125" width="105" height="70" fill="#16213e" rx="4"/>
  <rect x="148" y="125" width="105" height="70" fill="#16213e" rx="4"/>
  <rect x="266" y="125" width="105" height="70" fill="#16213e" rx="4"/>
  <!-- Label -->
  <text x="200" y="215" text-anchor="middle" fill="#9d9daf" font-family="Inter, sans-serif" font-size="10" opacity="0.6">Portföy Web Sitesi</text>
</svg>
