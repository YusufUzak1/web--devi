<svg xmlns="http://www.w3.org/2000/svg" width="400" height="225" viewBox="0 0 400 225">
  <defs>
    <linearGradient id="bg1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#16213e"/>
      <stop offset="100%" style="stop-color:#1a1a2e"/>
    </linearGradient>
  </defs>
  <rect width="400" height="225" fill="url(#bg1)" rx="8"/>
  <!-- App window frame -->
  <rect x="20" y="20" width="360" height="185" fill="#0f0f1a" rx="6"/>
  <circle cx="38" cy="32" r="5" fill="#ff6b6b"/>
  <circle cx="54" cy="32" r="5" fill="#ffd700"/>
  <circle cx="70" cy="32" r="5" fill="#00e676"/>
  <!-- Sidebar -->
  <rect x="20" y="42" width="80" height="163" fill="#1a1a2e" rx="0"/>
  <rect x="30" y="55" width="60" height="8" fill="#6c5ce7" rx="3" opacity="0.7"/>
  <rect x="30" y="72" width="50" height="6" fill="#9d9daf" rx="3" opacity="0.4"/>
  <rect x="30" y="86" width="55" height="6" fill="#9d9daf" rx="3" opacity="0.4"/>
  <rect x="30" y="100" width="45" height="6" fill="#9d9daf" rx="3" opacity="0.4"/>
  <!-- Main content -->
  <rect x="110" y="50" width="120" height="12" fill="#e4e4ed" rx="3" opacity="0.6"/>
  <rect x="110" y="72" width="250" height="40" fill="#1a1a2e" rx="4"/>
  <rect x="110" y="120" width="250" height="40" fill="#1a1a2e" rx="4"/>
  <rect x="110" y="168" width="120" height="30" fill="#6c5ce7" rx="4" opacity="0.8"/>
  <text x="200" y="210" text-anchor="middle" fill="#9d9daf" font-family="Inter, sans-serif" font-size="10" opacity="0.6">Eczane Yönetim Sistemi</text>
</svg>
