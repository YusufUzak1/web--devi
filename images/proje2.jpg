<svg xmlns="http://www.w3.org/2000/svg" width="400" height="225" viewBox="0 0 400 225">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#16213e"/>
      <stop offset="100%" style="stop-color:#1a1a2e"/>
    </linearGradient>
  </defs>
  <rect width="400" height="225" fill="url(#bg2)" rx="8"/>
  <!-- Face outline -->
  <circle cx="140" cy="100" r="50" fill="none" stroke="#00cec9" stroke-width="2" opacity="0.8"/>
  <circle cx="125" cy="88" r="6" fill="#00cec9" opacity="0.5"/>
  <circle cx="155" cy="88" r="6" fill="#00cec9" opacity="0.5"/>
  <path d="M120 115 Q140 130 160 115" fill="none" stroke="#00cec9" stroke-width="2" opacity="0.6"/>
  <!-- Data bars -->
  <rect x="230" y="50" width="60" height="12" fill="#00e676" rx="3" opacity="0.7"/>
  <text x="300" y="60" fill="#e4e4ed" font-size="10" font-family="Inter, sans-serif" opacity="0.7">Mutlu 78%</text>
  <rect x="230" y="72" width="30" height="12" fill="#ffd700" rx="3" opacity="0.7"/>
  <text x="270" y="82" fill="#e4e4ed" font-size="10" font-family="Inter, sans-serif" opacity="0.7">Sürpriz 12%</text>
  <rect x="230" y="94" width="20" height="12" fill="#a29bfe" rx="3" opacity="0.7"/>
  <text x="260" y="104" fill="#e4e4ed" font-size="10" font-family="Inter, sans-serif" opacity="0.7">Nötr 6%</text>
  <rect x="230" y="116" width="10" height="12" fill="#ff6b6b" rx="3" opacity="0.7"/>
  <text x="250" y="126" fill="#e4e4ed" font-size="10" font-family="Inter, sans-serif" opacity="0.7">Üzgün 4%</text>
  <!-- Label -->
  <text x="200" y="200" text-anchor="middle" fill="#9d9daf" font-family="Inter, sans-serif" font-size="10" opacity="0.6">Duygu Analizi Uygulaması</text>
</svg>
